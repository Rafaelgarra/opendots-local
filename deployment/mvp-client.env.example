# OpenDots and authenticated CLIs run on the company PC. No SSH client needed.
CONVERSATION_STORAGE=local
LOCAL_ONLY=true
LOCAL_MODEL_HOSTS=bc250-server.local
BC250_URL=https://bc250-server.local:44311
BC250_CA_FILE=.opendots/bc250-ca.pem
BC250_TOKEN=REPLACE_WITH_PRIVATE_BC_TOKEN_32_OR_MORE_CHARACTERS
BC250_DATA_CLASS=synthetic
BC250_COMPANY_AUTHORIZED=false
# Native workspace settings, pages and approval receipts; NOT conversation history.
# Start with a fresh synthetic workspace. Existing history is never uploaded.
DATABASE_PATH=data/mvp-workspace.sqlite
OWNER_ID=opendots-mvp-owner
OWNER_TOKEN=REPLACE_WITH_RANDOM_LOCAL_OWNER_TOKEN_32_OR_MORE_CHARACTERS
HOST=127.0.0.1
PORT=44310
CLI_CONFIG_FILE=.opendots/cli-projects.json
AGENT_RUN_TIMEOUT_MS=600000
WEB_SEARCH_PROVIDER=disabled
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
# If another browser device accesses this app, configure local HTTPS using
# scripts/setup-lan.ps1 and the exact APP_ORIGIN. Never expose the internal APIs.
